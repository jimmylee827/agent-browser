{
  "name": "agent-browser",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "General-purpose AI browser-control platform (MV3 extension + MCP server). Stealth-first: no CDP.",
  "license": "MIT",
  "author": "jimmylee827",
  "homepage": "https://github.com/jimmylee827/agent-browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimmylee827/agent-browser.git"
  },
  "bugs": {
    "url": "https://github.com/jimmylee827/agent-browser/issues"
  },
  "workspaces": [
    "packages/mcp-server"
  ],
  "scripts": {
    "launch": "bin/launch-chrome.sh",
    "build": "npm run build -w packages/mcp-server",
    "mcp": "npm run start -w packages/mcp-server",
    "mcp:dev": "npm run dev -w packages/mcp-server",
    "mcp:install": "node scripts/install-daemon.mjs",
    "mcp:uninstall": "node scripts/install-daemon.mjs --uninstall",
    "mcp:restart": "launchctl kickstart -k gui/$(id -u)/com.agent-browser.mcp-server 2>/dev/null || node scripts/install-daemon.mjs",
    "mcp:stop": "launchctl bootout gui/$(id -u)/com.agent-browser.mcp-server 2>/dev/null; echo 'browser server stopped (it starts again at login, or on the next browser tool call)'",
    "mcp:status": "curl -s http://127.0.0.1:8788/status || echo '(mcp server not reachable)'",
    "mcp:logs": "tail -f ~/.agent-chrome/mcp-server.err.log",
    "host-helper:install": "node host-helper/install.mjs",
    "host-helper:uninstall": "node host-helper/install.mjs --uninstall",
    "host-helper:status": "curl -s http://127.0.0.1:8789/health || echo '(host helper not reachable)'",
    "test": "node --test 'test/unit/*.test.mjs'",
    "test:e2e": "node --test --test-concurrency=1 'test/e2e/*.test.mjs'",
    "test:e2e:setup": "node test/e2e/setup.mjs",
    "smoke": "node scripts/smoke.mjs",
    "act-test": "node scripts/act-test.mjs",
    "reset-profile": "bin/reset-profile.sh",
    "halt": "mkdir -p ~/.agent-chrome && touch ~/.agent-chrome/HALT && echo 'KILL SWITCH ON — all browser actions blocked'",
    "resume": "rm -f ~/.agent-chrome/HALT && echo 'kill switch off'",
    "activity": "tail -f ~/.agent-chrome/audit.log"
  },
  "engines": {
    "node": ">=20"
  }
}
