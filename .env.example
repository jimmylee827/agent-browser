# agent-browser environment overrides. All optional; sensible defaults exist.
# Copy to .env (git-ignored) only if you need to override something.

# Bind interface for the in-container server. Override to 0.0.0.0 ONLY when the
# published host port is already restricted to 127.0.0.1. Default: loopback.
# AB_BIND_HOST=0.0.0.0

# Path to the bridge secret. Defaults to ~/.agent-chrome/bridge-secret.
# AB_BRIDGE_SECRET_FILE=/run/secrets/bridge-secret

# Where the optional host-helper daemon listens (loopback only).
# AB_HOST_HELPER_HOST=127.0.0.1
# AB_HOST_HELPER_PORT=8789
# AB_HOST_HELPER_SECRET_FILE=/run/secrets/host-helper-secret

# Disable the stdio MCP transport, leaving only Streamable HTTP at :8788/mcp.
# Set this when running the server as a long-lived daemon with no stdin.
# AB_DISABLE_STDIO_MCP=1

# Dry-run: browser_act / browser_navigate report their intent without
# executing. Useful when testing an agent against the tool surface.
# AB_DRY_RUN=1

# V8 max old-space heap (MB) for the browser. Default = Chrome's own ceiling.
# Set only if a legitimately heavy page hits OOM.
# AB_V8_HEAP_MB=8192
