{
  "manifest_version": 3,
  "name": "Agent Bridge",
  "version": "0.0.3",
  "description": "Local AI browser-control bridge. Stealth-first: no CDP, no debugger.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation",
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*/*.pdf"
      ],
      "js": [
        "src/content/engine.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
